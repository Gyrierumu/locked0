# Public application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase values exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only values
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platify
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Editorial media Storage (server-only configuration)
SUPABASE_MEDIA_BUCKET=locked0-media
SUPABASE_MEDIA_STAGING_BUCKET=locked0-media-staging
